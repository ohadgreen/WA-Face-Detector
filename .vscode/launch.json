{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WhatsApp Web + extension (fresh profile)",
      "type": "chrome",
      "request": "launch",
      "url": "https://web.whatsapp.com",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.chrome-profile",
      "runtimeArgs": [
        "--load-extension=${workspaceFolder}",
        "--disable-extensions-except=${workspaceFolder}"
      ]
    },
    {
      "name": "Attach to Chrome on :9222",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ]
}
